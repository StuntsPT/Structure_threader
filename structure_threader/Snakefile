# Structure_threader Snakemake workflow
#
# Supported wrappers: structure, faststructure, maverick, alstructure, neuraladmixture
# Clumppling alignment: supported for all wrappers except supervised NeuralAdmixture
#
# Pipeline DAG per wrapper:
#
#   STRUCTURE:
#     prepare_dirs → run_structure (K × R parallel jobs)
#                        └─► bestk → plot
#
#   fastSTRUCTURE:
#     prepare_dirs → run_faststructure (K parallel jobs)
#                        └─► bestk → plot
#
#   MavericK:
#     prepare_dirs → run_maverick (K parallel jobs)
#                        └─► merge_maverick (aggregation + bestK) → plot
#
#   ALStructure:
#     prepare_dirs → prepare_alstructure_input (VCF→TSV conversion, host-side)
#                        └─► run_alstructure (K sequential jobs, threads=1)
#                                └─► bestk_alstructure (all K, no method)
#                                        └─► plot
#                                └─► cleanup_alstructure_input (removes TSV)
#
# All parameters come from config.yaml (written by the CLI shim).

import os
import random
import itertools

# ---------------------------------------------------------------------------
# Config helpers
# ---------------------------------------------------------------------------

def _require(key):
    val = config.get(key)
    if not val:
        raise ValueError(f"[structure_threader] '{key}' is required in config.")
    return val


# ---------------------------------------------------------------------------
# Resolve shared parameters
# ---------------------------------------------------------------------------

WRAPPER  = _require("wrapper")
INFILE   = os.path.abspath(_require("infile"))
OUTDIR   = os.path.abspath(_require("outdir"))

K_LIST   = list(range(1, config["K"] + 1)) if isinstance(config.get("K"), int) \
           else list(config.get("K_list", []))
if not K_LIST:
    raise ValueError("[structure_threader] Provide 'K' (int) or 'K_list' (list) in config.")

# ALStructure cannot handle K=1 — strip it here so all downstream rules
# see the corrected list. The shim also strips it, but we guard here too.
if WRAPPER == "alstructure" or WRAPPER == "neuraladmixture":
    K_LIST = [k for k in K_LIST if k != 1]
    if not K_LIST:
        raise ValueError(f"[structure_threader] {WRAPPER} requires at least one K > 1.")

SEED     = config.get("seed", 1235813)
POPFILE  = config.get("popfile")
INDFILE  = config.get("indfile")
NO_TESTS = config.get("no_tests", False)
NO_PLOTS = config.get("no_plots", False)
BW       = config.get("blacknwhite", False)
USE_IND  = config.get("use_ind_labels", False)
THREADS  = config.get("threads", 4)

# ALStructure forces sequential execution regardless of -t
if WRAPPER == "alstructure":
    THREADS = 1

# STRUCTURE-specific
REPLICATES = list(range(1, config.get("replicates", 20) + 1))
MAINPARAMS = config.get("mainparams")

# fastSTRUCTURE-specific
FS_PRIOR   = config.get("fs_prior", "simple")

# MavericK-specific
MAV_PARAMS = os.path.abspath(config["mav_params"]) if config.get("mav_params") else None

# ALStructure-specific: resolve infile and intermediate TSV path at DAG-build time
# (needed in both _targets() and alstructure.smk)
def _als_infile_and_tsv():
    if INFILE.endswith((".bed", ".fam", ".bim")):
        return INFILE[:-4], None
    elif INFILE.endswith(".vcf.gz"):
        vcf = INFILE[:-3]
        tsv = vcf[:-4] + ".tsv"
        return tsv, tsv
    elif INFILE.endswith(".vcf"):
        tsv = INFILE[:-4] + ".tsv"
        return tsv, tsv
    else:
        return INFILE, None

if WRAPPER == "alstructure":
    ALS_RSCRIPT_INFILE, ALS_TSV_TO_CLEAN = _als_infile_and_tsv()
else:
    ALS_RSCRIPT_INFILE, ALS_TSV_TO_CLEAN = None, None

# ---------------------------------------------------------------------------
# Binary path for --no-container mode
# When containers are used this is None and each rule uses the binary name
# baked into the container's PATH. When --no-container is active this holds
# the user-supplied path (or a sensible default bare name as fallback).
# ---------------------------------------------------------------------------

_DEFAULT_BINS = {
    "structure":       "structure",
    "faststructure":   "structure.py",
    "maverick":        "MavericK",
    "alstructure":     "Rscript",
    "neuraladmixture": "neural-admixture",
    "clumppling":      "python",   # invoked as 'python -m clumppling'
}

NO_CONTAINER  = config.get("no_container", False)
WRAPPER_BIN   = config.get("wrapper_bin") or _DEFAULT_BINS.get(WRAPPER, WRAPPER)
# Clumppling always uses 'python' as its executable (python -m clumppling),
# but in --no-container mode the user may need a specific python path.
CLUMPPLING_BIN = config.get("clumppling_bin", "python")

# Container images
STRUCTURE_IMAGE = config.get(
    "structure_image",
    "docker://docker.io/stunts/structure:2.3.4_0"
)
FASTSTRUCTURE_IMAGE = config.get(
    "faststructure_image",
    "docker://docker.io/stunts/faststructure:1.0_0"
)
MAVERICK_IMAGE = config.get(
    "maverick_image",
    "docker://docker.io/stunts/maverick:1.0.4_0"
)
ALSTRUCTURE_IMAGE = config.get(
    "alstructure_image",
    "docker://docker.io/stunts/alstructure:e355411_0"
)

# ---------------------------------------------------------------------------
# Per-run seed map for STRUCTURE
# ---------------------------------------------------------------------------

def _make_seed_map(seed, k_list, replicates):
    """Return {(k, rep): seed_string}."""
    jobs = list(itertools.product(k_list, replicates))[::-1]
    random.seed(seed)
    return {(k, r): str(random.randrange(10_000_000)) for k, r in jobs}

SEED_MAP = _make_seed_map(SEED, K_LIST, REPLICATES)

# ---------------------------------------------------------------------------
# MavericK alpha failsafe helper
# ---------------------------------------------------------------------------

def _mav_alpha_args(k_val):
    """Return extra CLI flags for per-K alpha/alphaPropSD values, or ''."""
    if MAV_PARAMS is None:
        return ""
    try:
        import structure_threader.wrappers.maverick_wrapper as mw
    except ImportError:
        import sys
        _wf_dir = os.path.dirname(os.path.abspath(workflow.snakefile))
        sys.path.insert(0, _wf_dir)
        import wrappers.maverick_wrapper as mw

    mav_params = mw.mav_params_parser(MAV_PARAMS)
    failsafe   = mw.mav_alpha_failsafe(mav_params, K_LIST)
    args = []
    for param, per_k in failsafe.items():
        if per_k is not False and k_val in per_k:
            args += [f"-{param}", per_k[k_val]]
    return " ".join(args)

# ---------------------------------------------------------------------------
# Sentinel and output-file path helpers
# ---------------------------------------------------------------------------

DIRS_SENTINEL = os.path.join(OUTDIR, ".dirs_ready")
ALS_INPUT_SENTINEL = os.path.join(OUTDIR, ".alstructure_input_ready")
# Bundled R wrapper script — lives in the repo alongside the Snakefile.
# Declared as a rule input so Snakemake tracks it and Apptainer bind-mounts
# its parent directory automatically.
ALS_WRAPPER_R = os.path.join(
    os.path.dirname(os.path.abspath(workflow.snakefile)),
    "wrappers", "alstructure_wrapper.R"
)

def bestk_sentinel():
    return os.path.join(OUTDIR, "bestK", "bestK.txt")

def plot_sentinel():
    return os.path.join(OUTDIR, "plots", "plots.done")

def all_structure_f_files():
    return [os.path.join(OUTDIR, f"str_K{k}_rep{r}_f")
            for k in K_LIST for r in REPLICATES]

def all_fs_meanq_files():
    return [os.path.join(OUTDIR, f"fS_run_K.{k}.meanQ") for k in K_LIST]

def all_mav_qmatrix_files():
    return [os.path.join(OUTDIR, f"mav_K{k}", f"outputQmatrix_ind_K{k}.csv")
            for k in K_LIST]

def all_als_qfiles():
    return [os.path.join(OUTDIR, f"alstr_K{k}") for k in K_LIST]

# ---------------------------------------------------------------------------
# Rules that must always run on the host (never containerised)
# ---------------------------------------------------------------------------

localrules: all, prepare_dirs, prepare_clumppling_input


# ===========================================================================
# NeuralAdmixture-specific constants
# Resolved at DAG-build time so both _targets() and neuraladmixture.smk
# share the same values without recomputing them.
# ===========================================================================

NAD_EXEC_MODE  = config.get("nad_exec_mode", "train")
NAD_SUPERVISED = config.get("nad_supervised", False)
NAD_POPFILE    = config.get("nad_popfile")
NAD_INIT       = config.get("nad_init")
NAD_THREADS    = config.get("nad_threads", 1)   # passed as --threads to NAD (required)
NAD_GPUS       = config.get("nad_gpus", 0)
NAD_SEED       = config.get("nad_seed", SEED)   # NAD-specific seed; falls back to global SEED
NAD_INPUT_SENTINEL = os.path.join(OUTDIR, ".neuraladmixture_input_ready")

# Resolve the infile NAD actually receives (VCF.GZ → extract .vcf first)
if WRAPPER == "neuraladmixture" and INFILE.endswith(".vcf.gz"):
    NAD_INFILE = INFILE[:-3]   # extracted .vcf path
else:
    NAD_INFILE = INFILE

# Supervised-mode constants (only meaningful when NAD_SUPERVISED=True)
def _nad_count_pops(popfile):
    """Count unique populations in the NAD population file."""
    if not popfile or not os.path.isfile(popfile):
        return 0
    pops = set()
    with open(popfile) as fh:
        for line in fh:
            p = line.strip().upper()
            if p:
                pops.add(p)
    return len(pops)

if WRAPPER == "neuraladmixture":
    NAD_N_POPS = _nad_count_pops(NAD_POPFILE) if NAD_SUPERVISED else 0
    NAD_SUPERVISED_RUN_NAME  = f"nad_K{NAD_N_POPS}_supervised"
    NAD_SUPERVISED_OUTPUT_DIR = os.path.join(OUTDIR, NAD_SUPERVISED_RUN_NAME) + os.sep
    NAD_SUPERVISED_QFILE = os.path.join(
        OUTDIR, NAD_SUPERVISED_RUN_NAME,
        f"nad_K{NAD_N_POPS}_supervised.{NAD_N_POPS}.Q"
    )
else:
    NAD_N_POPS = 0
    NAD_SUPERVISED_RUN_NAME  = ""
    NAD_SUPERVISED_OUTPUT_DIR = ""
    NAD_SUPERVISED_QFILE = ""

NEURALADMIXTURE_IMAGE = config.get(
    "neuraladmixture_image",
    "docker://docker.io/stunts/neural-admixture:1.6.7_0"
)
CLUMPPLING_IMAGE = config.get(
    "clumppling_image",
    "docker://docker.io/stunts/clumppling:2.0.7_0"
)

# Clumppling is skipped for: supervised NeuralAdmixture (single run, no alignment
# makes sense), and when the user passes --no_clumpp.
NO_CLUMPP = config.get("no_clumpp", False)

def clumppling_sentinel():
    return os.path.join(OUTDIR, "clumpp", ".clumppling_done")

CLUMPPLING_INPUT_SENTINEL = os.path.join(OUTDIR, ".clumppling_input_ready")

def all_nad_qfiles():
    if NAD_SUPERVISED:
        return [NAD_SUPERVISED_QFILE]
    return [os.path.join(OUTDIR, f"nad_K{k}", f"nad_K{k}.{k}.Q")
            for k in K_LIST]

# ---------------------------------------------------------------------------
# Target rule
# ---------------------------------------------------------------------------

def _targets():
    t = []
    if WRAPPER == "structure":
        t += all_structure_f_files()
    elif WRAPPER == "faststructure":
        t += all_fs_meanq_files()
    elif WRAPPER == "maverick":
        t += all_mav_qmatrix_files()
    elif WRAPPER == "alstructure":
        t += all_als_qfiles()
        # Always write bestk sentinel for alstructure (notests is always True)
        t.append(bestk_sentinel())
        # Cleanup sentinel if VCF input was used
        if ALS_TSV_TO_CLEAN:
            t.append(os.path.join(OUTDIR, ".alstructure_cleanup_done"))
    elif WRAPPER == "neuraladmixture":
        t += all_nad_qfiles()
        # notests is always True for NAD
        t.append(bestk_sentinel())
        # Cleanup sentinel if VCF.GZ input was used
        if INFILE.endswith(".vcf.gz"):
            t.append(os.path.join(OUTDIR, ".neuraladmixture_cleanup_done"))
        # Supervised mode: no plots
        if NAD_SUPERVISED:
            return t
    if WRAPPER not in ("alstructure", "neuraladmixture") and not NO_TESTS:
        t.append(bestk_sentinel())
    if not NO_PLOTS:
        t.append(plot_sentinel())
    # Clumppling: runs after primary outputs exist; skip for supervised NAD
    if not NO_CLUMPP and not (WRAPPER == "neuraladmixture" and NAD_SUPERVISED):
        t.append(clumppling_sentinel())
    return t

rule all:
    input: _targets()


# ---------------------------------------------------------------------------
# Include shared and wrapper-specific rules
# ---------------------------------------------------------------------------

include: "rules/common.smk"

if WRAPPER == "structure":
    include: "rules/structure.smk"
elif WRAPPER == "faststructure":
    include: "rules/faststructure.smk"
elif WRAPPER == "maverick":
    include: "rules/maverick.smk"
elif WRAPPER == "alstructure":
    include: "rules/alstructure.smk"
elif WRAPPER == "neuraladmixture":
    include: "rules/neuraladmixture.smk"

# Clumppling is always included (available for all wrappers that support it)
if not NO_CLUMPP and not (WRAPPER == "neuraladmixture" and NAD_SUPERVISED):
    include: "rules/clumppling.smk"
else:
    raise ValueError(f"[structure_threader] Unknown wrapper '{WRAPPER}'. "
                     "Supported: structure, faststructure, maverick, alstructure, neuraladmixture")
